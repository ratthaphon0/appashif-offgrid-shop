NODE_ENV=development
HOST=0.0.0.0
PORT=3000
API_PREFIX=/api/v1

DB_HOST=localhost
DB_PORT=3306
DB_USER=your_mysql_user
DB_PASSWORD=your_mysql_password
DB_NAME=appashif_demo
DB_CONNECTION_LIMIT=10

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

# Comma-separated browser origins. Native Expo requests do not send an Origin.
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
CORS_ALLOW_ALL=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOG_LEVEL=info

DEPLOYMENT_SOURCE=classroom-mysql
DEPLOYMENT_OWNER=classroom-student
DEPLOYMENT_LABEL=CLASSROOM • MYSQL • PORT 3000

# Used by npm run api:check. Set ADMIN_EMAIL and ADMIN_PASSWORD only in the
# current shell when running the full mutation check; do not commit them.
API_BASE_URL=http://127.0.0.1:3000/api/v1
